msgstr "Rollback iniciado para o snapshot #{num}. Reinicie para concluir."

msgid "Select Snapshot to Restore"
msgstr "Selecionar snapshot a restaurar"

msgid "Select a snapshot to restore the system to:"
msgstr "Selecione um snapshot para restaurar o sistema a ele:"

msgid "Server URLs must use http(s) and contain no line breaks."
msgstr "URLs de servidor devem usar http(s) e não conter quebras de linha."

msgid "Snapper Not Available"
msgstr "Snapper indisponível"

msgid "Snapper needs a BTRFS filesystem and a configuration."
msgstr "O Snapper precisa de um sistema de arquivos BTRFS e de uma configuração."

msgid "Snapper needs a BTRFS filesystem, the 'snapper' tool and a configuration. Create one with: sudo snapper create-config /"
msgstr "O Snapper precisa de um sistema de arquivos BTRFS, da ferramenta 'snapper' e de uma configuração. Crie uma com: sudo snapper create-config /"

msgid "Snapshot"
msgstr "Snapshot"

msgid "Snapshot created successfully: {comment}"
msgstr "Snapshot criado com sucesso: {comment}"

msgid "Snapshot created successfully: {date}"
msgstr "Snapshot criado com sucesso: {date}"

msgid "Snapshot creation timed out and no snapshot appeared in Timeshift's list.\n{err}"
msgstr "A criação do snapshot expirou e nenhum snapshot apareceu na lista do Timeshift.\n{err}"

msgid "Snapshot restoration initiated. System will reboot."
msgstr "Restauração do snapshot iniciada. O sistema será reiniciado."

msgid "The snapshot did not appear in Timeshift's list.\nCommand output: {out}"
msgstr "O snapshot não apareceu na lista do Timeshift.\nSaída do comando: {out}"

msgid "This will delete old snapshots to free up disk space.\n\nKeep only the 2 most recent snapshots?\n\nThis action cannot be undone."
msgstr "Isso excluirá snapshots antigos para liberar espaço em disco.\n\nManter apenas os 2 snapshots mais recentes?\n\nEsta ação não pode ser desfeita."

msgid "This will roll back the system to snapper snapshot #{num}.\n\nSnapper switches the default subvolume; a reboot is required.\n\nAre you sure you want to proceed?"
msgstr "Isso reverterá o sistema para o snapshot snapper #{num}.\n\nO Snapper alterna o subvolume padrão; é necessário reiniciar.\n\nTem certeza de que deseja continuar?"

msgid "Timeshift is busy with another backup in progress (scheduled or manual). Try again after it finishes."
msgstr "O Timeshift está ocupado com outro backup em andamento (agendado ou manual). Tente novamente quando terminar."

msgid "Timeshift list failed"
msgstr "Falha na lista do Timeshift"

msgid "curl isn't installed; install 'curl' to fetch the mirror list."
msgstr "curl não está instalado; instale 'curl' para buscar a lista de mirrors."

msgid "stable"
msgstr "estável"

msgid "Chaotic AUR is built against Arch's newest (unstable) libraries. Manjaro is on the '{branch}' branch, which lags behind Arch and can break on mixed package sets. Switch to 'unstable' first (recommended only for experienced users)."
msgstr "O Chaotic AUR é compilado contra as bibliotecas mais recentes (instáveis) do Arch. O Manjaro está no ramo '{branch}', que fica atrás do Arch e pode quebrar com conjuntos de pacotes mistos. Mude primeiro para 'unstable' (recomendado apenas para usuários experientes)."
