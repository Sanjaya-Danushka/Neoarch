msgstr "月"

msgid "Needs a BTRFS filesystem"
msgstr "BTRFS ファイルシステムが必要"

msgid "Needs a snapper config (sudo snapper create-config /)"
msgstr "snapper の設定が必要 (sudo snapper create-config /)"

